PORT=3000
PUBLIC_BASE_URL=https://your-app.example.com

# Shared secret ManyChat sends in the X-Webhook-Secret header
MANYCHAT_WEBHOOK_SECRET=change-me
# Shared secret your website form sends in the X-Webhook-Secret header
FORM_WEBHOOK_SECRET=change-me

# OpenAI (leave empty to use the built-in rule-based qualifier)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# HubSpot private app token (scopes: crm.objects.contacts.write, crm.objects.deals.write)
HUBSPOT_TOKEN=
HUBSPOT_PIPELINE_ID=default
HUBSPOT_STAGE_QUALIFIED=appointmentscheduled
HUBSPOT_STAGE_NURTURE=qualifiedtobuy

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Meta Conversions API
META_PIXEL_ID=
META_ACCESS_TOKEN=
META_TEST_EVENT_CODE=

# Set to true to log outbound calls instead of sending them
DRY_RUN=true
